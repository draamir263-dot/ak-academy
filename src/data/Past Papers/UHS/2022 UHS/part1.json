  {"id":"m1","subject":"Biology","year":"MDCAT 2023","chapter":"Cell Biology","question":"Which organelle is known as the 'suicidal bags' of the cell?","optionA":"Ribosomes","optionB":"Mitochondria","optionC":"Lysosomes","optionD":"Golgi apparatus","correctAnswer":"C","explanation":"Lysosomes contain digestive enzymes that can cause autolysis.","explanationA":"Incorrect. Ribosomes synthesize proteins.","explanationB":"Incorrect. Mitochondria produce ATP.","explanationC":"Correct! Lysosomes are suicidal bags.","explanationD":"Incorrect. Golgi apparatus packages proteins.","summary":"Lysosomes","difficulty":"Easy"},
  {"id":"m2","subject":"Biology","year":"MDCAT 2023","chapter":"Cell Biology","question":"The fluid mosaic model of the cell membrane was proposed by:","optionA":"Schleiden and Schwann","optionB":"Singer and Nicolson","optionC":"Robert Hooke","optionD":"Rudolf Virchow","correctAnswer":"B","explanation":"Singer and Nicolson proposed the fluid mosaic model in 1972.","explanationA":"Incorrect. They proposed cell theory.","explanationB":"Correct! Proposed by Singer and Nicolson.","explanationC":"Incorrect. Hooke discovered cells.","explanationD":"Incorrect. Virchow proposed cell lineage.","summary":"Fluid Mosaic Model","difficulty":"Medium"},
